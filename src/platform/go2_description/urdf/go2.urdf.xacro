<?xml version="1.0"?>
<!--
  go2.urdf.xacro
  Hardware Go2 robot description for Nav2 navigation and RViz visualization.

  Frame tree (Nav2 standard contract):
    base_footprint  (published dynamically by the hardware bridge / sim launch)
      += base_link             (robot body center at standing height, roll/pitch-capable)
           += trunk             (Go2 body mesh; fixed offset, identity)
           |    += {lf,rf,lh,rh}_hip_link -> {..}_upper_leg_link -> {..}_lower_leg_link -> {LF,RF,LH,RH}_FOOT
           += imu_link          (co-located with trunk centre)
           += lidar_link        (Unitree L1 LiDAR mount, real driver orientation)

  Notes:
    - This URDF is rooted at base_link. base_footprint is intentionally not part of
      robot_description so bringup can publish base_footprint->base_link dynamically
      from IMU roll/pitch without conflicting with robot_state_publisher.
    - lidar_link pose matches the Go2 mounting location used by Nav2/SLAM (real
      driver orientation; see go2_sim/urdf/go2_sim.urdf.xacro for the Fortress
      workaround used in simulation).
    - Leg links + joints are present so RViz mirrors the real robot pose when
      go2_hw_bridge publishes /joint_states from /lowstate.motor_state[].q. The
      ros2_control block from leg.xacro is gated off here (hardware does not use
      ign_ros2_control).
    - base_link keeps two collision boxes (trunk + safety envelope) so Nav2
      consumers that read URDF collision geometry get the standing footprint
      independent of leg articulation.

  TODO(agibot): Create agibot_d1_description/urdf/d1.urdf.xacro with the same
                frame names (base_footprint, base_link, lidar_link, imu_link).
-->
<robot name="go2" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Shared geometry: leg/joint constants, mesh materials, parametric leg macro. -->
  <xacro:include filename="$(find go2_description)/urdf/const.xacro"/>
  <xacro:include filename="$(find go2_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find go2_description)/urdf/leg.xacro"/>

  <!-- =======================================================================
       Physical constants
  ============================================================================ -->
  <xacro:property name="body_length"  value="0.440"/>   <!-- trunk X -->
  <xacro:property name="body_width"   value="0.060"/>   <!-- trunk half-width in Y -->
  <xacro:property name="body_height"  value="0.100"/>   <!-- trunk Z -->
  <xacro:property name="body_mass"    value="6.921"/>

  <!-- Full robot standing envelope including legs (Unitree Go2 official specs) -->
  <xacro:property name="stance_length"  value="0.700"/>  <!-- full X with legs -->
  <xacro:property name="stance_width"   value="0.310"/>  <!-- full Y with legs -->
  <xacro:property name="safety_length"  value="0.800"/>  <!-- +50 mm safety margin on each side -->
  <xacro:property name="safety_width"   value="0.410"/>  <!-- +50 mm safety margin on each side -->
  <xacro:property name="stance_height"  value="0.230"/>  <!-- approx clearance:
                                                              ground to body bottom
                                                              (standing_height - body_height/2)
                                                              = 0.28 - 0.05 = 0.23 m -->

  <!-- Nominal standing torso centre height from ground [m]. -->
  <xacro:property name="standing_height" value="0.28"/>

  <!-- Front-top sensor mount matching official Unitree Go2 radar_joint -->
  <xacro:property name="lidar_x" value="0.28945"/>
  <xacro:property name="lidar_y" value="0.0"/>
  <xacro:property name="lidar_z" value="-0.046825"/>
  <!-- Real Unitree driver frame measured from /utlidar/cloud to /utlidar/cloud_base. -->
  <xacro:property name="lidar_r" value="0.0"/>
  <xacro:property name="lidar_p" value="2.88000012056847"/>
  <xacro:property name="lidar_yaw" value="0.0"/>

  <!-- =======================================================================
       base_link  -  virtual root + Nav2 collision geometry
       Visuals live on `trunk` (Go2 body mesh) and the leg links instantiated
       below. The collision boxes here express the full standing footprint for
       Nav2 consumers that read URDF collision geometry.
  ============================================================================ -->
  <link name="base_link">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- Rigid body torso footprint (full standing envelope is via the
             safety collision below and nav2 footprint parameters). -->
        <box size="${body_length} ${body_width*2} ${body_height}"/>
      </geometry>
    </collision>
    <!-- Safety envelope used by collision consumers that inspect URDF collision geometry. -->
    <collision>
      <origin xyz="0 0 ${-(standing_height - stance_height/2)}" rpy="0 0 0"/>
      <geometry>
        <box size="${safety_length} ${safety_width} ${stance_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- =======================================================================
       trunk  -  Go2 body mesh, fixed offset from base_link
       Matches the sim URDF (go2_sim.urdf.xacro) so RViz appearance and the leg
       attachment frame are identical between sim and real.
  ============================================================================ -->
  <joint name="floating_base" type="fixed">
    <parent link="base_link"/>
    <child  link="trunk"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="trunk">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://go2_description/meshes/dae/base.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <inertial>
      <origin xyz="${trunk_com_x} ${trunk_com_y} ${trunk_com_z}" rpy="0 0 0"/>
      <mass value="${trunk_mass}"/>
      <inertia ixx="${trunk_ixx}" ixy="${trunk_ixy}" ixz="${trunk_ixz}"
               iyy="${trunk_iyy}" iyz="${trunk_iyz}"
               izz="${trunk_izz}"/>
    </inertial>
  </link>

  <!-- =======================================================================
       Articulated legs - joint_states fed by go2_hw_bridge from /lowstate.
       Same macro and mirroring scheme as the sim URDF; ros2_control block is
       gated off (hardware does not use ign_ros2_control).
  ============================================================================ -->
  <xacro:leg name="rf" mirror="-1" mirror_dae="False" front_hind="1"  front_hind_dae="True"  parent="trunk" with_ros2_control="False"/>
  <xacro:leg name="lf" mirror="1"  mirror_dae="True"  front_hind="1"  front_hind_dae="True"  parent="trunk" with_ros2_control="False"/>
  <xacro:leg name="rh" mirror="-1" mirror_dae="False" front_hind="-1" front_hind_dae="False" parent="trunk" with_ros2_control="False"/>
  <xacro:leg name="lh" mirror="1"  mirror_dae="True"  front_hind="-1" front_hind_dae="False" parent="trunk" with_ros2_control="False"/>

  <!-- =======================================================================
       imu_link  -  co-located with trunk centre (Go2 internal IMU)
  ============================================================================ -->
  <joint name="base_link_to_imu" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>

  <!-- =======================================================================
       lidar_link  -  Unitree L1 raw pointcloud frame on real hardware
  ============================================================================ -->
  <joint name="base_link_to_lidar" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="${lidar_r} ${lidar_p} ${lidar_yaw}"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.06"/>
      </geometry>
      <material name="lidar_black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>

  <!-- ====================================================================
       lidar_imu_link  -  Unitree UniLidar built-in IMU origin
       Offset within the L1 sensor body, published by robot_state_publisher.
       lio.launch.py must use publish_lidar_imu_tf:=false on hardware to avoid
       duplicating this TF.  In simulation this joint is already defined in
       go2_sim.urdf.xacro; on hardware the URDF is the authoritative source.
       ==================================================================== -->
  <joint name="lidar_to_lidar_imu" type="fixed">
    <parent link="lidar_link"/>
    <child  link="lidar_imu_link"/>
    <origin xyz="-0.007698 -0.014655 0.00667" rpy="0 0 0"/>
  </joint>

  <link name="lidar_imu_link">
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>

</robot>
