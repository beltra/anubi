<?xml version="1.0"?>
<!--
  a2w.urdf.xacro - Unitree A2-W (Pro): official A2-W body/legs/wheels + front/rear LiDAR.

  Body, legs and wheels come from the official Unitree A2-W URDF (a2w_body.urdf.xacro,
  generated from a2w_upstream.urdf; wheel joints <LEG>_wheel_joint). That file has no
  sensor frames, so the LiDAR and camera mounts below are taken from the legged A2
  URDF (a2_upstream.urdf, unitree_ros), which shares the A2-W body shell.

  fixed_legs:=false (real): leg joints are revolute and follow /joint_states.
  fixed_legs:=true  (sim):  leg and wheel joints are fixed in the standing pose below,
                            so the URDF->SDF conversion lumps the robot into one base_link.

  Frames added for the autonomy stack (docs/topic_map.md, A2-W section):
    imu_link          body IMU at the base origin
    front_lidar_link  front JT128, z = dome axis pointing +x (upstream pose)
    rear_lidar_link   rear JT128,  z = dome axis pointing -x (upstream pose)
    lidar_link        virtual merged-cloud frame: identity rotation, at the mean
                      height of the two sensors, so distortion_corrector needs
                      only a translation (sensor_mount_rpy = 0)
-->
<robot name="a2w" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="fixed_legs" default="false"/>

  <xacro:property name="fixed_legs" value="$(arg fixed_legs)"/>
  <xacro:property name="leg_joint_type" value="${'fixed' if fixed_legs else 'revolute'}"/>
  <xacro:property name="wheel_joint_type" value="${'fixed' if fixed_legs else 'continuous'}"/>

  <!-- Standing pose (rad). Base height = wheel-axle depth + tyre radius
       = 0.275*(cos(0.8) + cos(0.7)) + 0.0948 ~= 0.497 m. -->
  <xacro:property name="stand_hip"   value="0.0"/>
  <xacro:property name="stand_thigh" value="0.8"/>
  <xacro:property name="stand_calf"  value="-1.5"/>

  <xacro:macro name="leg_angles" params="leg">
    <xacro:property name="${leg}_q_hip"   value="${stand_hip if fixed_legs else 0.0}" scope="parent"/>
    <xacro:property name="${leg}_q_thigh" value="${stand_thigh if fixed_legs else 0.0}" scope="parent"/>
    <xacro:property name="${leg}_q_calf"  value="${stand_calf if fixed_legs else 0.0}" scope="parent"/>
  </xacro:macro>
  <xacro:leg_angles leg="FL"/>
  <xacro:leg_angles leg="FR"/>
  <xacro:leg_angles leg="RL"/>
  <xacro:leg_angles leg="RR"/>

  <xacro:include filename="$(find a2w_description)/urdf/a2w_body.urdf.xacro"/>


  <!-- Sensor frames. Tiny inertials keep them through URDF->SDF fixed-joint lumping. -->
  <xacro:macro name="sensor_frame" params="name parent xyz rpy">
    <link name="${name}">
      <inertial>
        <mass value="0.001"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <xacro:sensor_frame name="imu_link" parent="base_link" xyz="0 0 0" rpy="0 0 0"/>
  <!-- Upstream: front at (0.33767, 0, 0.08134) rpy (pi/2, 0, pi/2); rear is defined
       upstream relative to front and resolves to (-0.28003, 0, 0.08734) with the dome
       axis along -x (rpy pi/2, 0, -pi/2). -->
  <xacro:sensor_frame name="front_lidar_link" parent="base_link"
                      xyz="0.33767 0.0 0.08134" rpy="${pi/2} 0 ${pi/2}"/>
  <xacro:sensor_frame name="rear_lidar_link" parent="base_link"
                      xyz="-0.28003 0.0 0.08734" rpy="${pi/2} 0 ${-pi/2}"/>
  <xacro:sensor_frame name="lidar_link" parent="base_link"
                      xyz="0.0 0.0 0.0843" rpy="0 0 0"/>
  <xacro:sensor_frame name="camera_link" parent="base_link"
                      xyz="0.3381 0.0336 0.0525" rpy="0 0 0"/>

</robot>
