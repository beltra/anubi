<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_description</name>
  <version>0.1.0</version>
  <description>
    Unitree G1 29-DoF URDF + meshes vendored for the anubi Nav2 stack.
    Wraps the official Unitree model and adds base_link / base_footprint /
    lidar_stabilized frames needed by navigation.
  </description>
  <maintainer email="gabriel.voss01@gmail.com">Gabriel Voss</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- xacro expands g1.urdf.xacro at launch; RSP/JSP publish TF + joint states. -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
