<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>a2w_bringup</name>
  <version>0.1.0</version>
  <description>
    Unitree A2-W (Pro) real-robot bringup. Launch and config only: the Sport API
    adapter is go2_hw_bridge (same SportClient Move / SportModeState contract on the
    A2 topics), the two Hesai JT128 clouds are fused by robot_nav cloud_merger, and
    the autonomy stack is the shared robot_nav / robot_lio / robot_safety packages.
  </description>
  <maintainer email="gbeve2002@gmail.com">Gabriele Beltrami</maintainer>
  <license>AGPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>a2w_description</exec_depend>
  <exec_depend>go2_bringup</exec_depend>
  <exec_depend>robot_nav</exec_depend>
  <exec_depend>robot_lio</exec_depend>
  <exec_depend>robot_safety</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
