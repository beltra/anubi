Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /RobotModel1
        - /TF1
        - /Map1
      Splitter Ratio: 0.5
    Tree Height: 166
  - Class: rviz_common/Selection
