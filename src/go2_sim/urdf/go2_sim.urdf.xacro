    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="-0.002 0 0"/>
      <geometry>
        <sphere radius="0.022"/>
      </geometry>
    </collision>
  </link>

  <joint name="FL_foot_joint" type="fixed">
    <origin xyz="0 0 -0.213" rpy="0 0 0"/>
    <parent link="FL_calf"/>
    <child link="FL_foot"/>
  </joint>

  <link name="FR_hip">
