<?xml version="1.0"?>
<!--
  go2_sim.urdf.xacro
  Unitree Go2 - Gazebo Classic (Gazebo 11) simulation model.

  This model keeps the detailed Go2 visuals while preserving the planar-move
  physics contract that the old working simulation relied on:
    - Visual-only legs and sensor pods for appearance
    - A simplified torso collision plus a flat contact proxy for stable planar motion
    - Unchanged Nav2-facing topics and frames
-->
<robot name="go2_sim" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find sensor_models)/urdf/l1_lidar.urdf.xacro"/>

  <xacro:property name="mesh_pkg" value="go2_sim"/>

  <xacro:property name="trunk_length" value="0.3762"/>
  <xacro:property name="trunk_width" value="0.0935"/>
  <xacro:property name="trunk_height" value="0.114"/>
  <xacro:property name="trunk_mass" value="6.921"/>
  <!-- Keep the planar-move physics frame at the old stable height.
       Detailed visuals are offset separately so the rendered model still
       matches the newer Go2 appearance without raising the COM. -->
  <xacro:property name="base_z" value="0.335"/>
  <xacro:property name="visual_z_offset" value="0.045"/>

  <xacro:property name="contact_proxy_length" value="0.5794"/>
  <xacro:property name="contact_proxy_width" value="0.328"/>
  <xacro:property name="contact_proxy_height" value="0.020"/>
  <xacro:property name="contact_proxy_z" value="${-(base_z - (contact_proxy_height * 0.5))}"/>

  <xacro:property name="q_hip" value="0.0"/>
  <xacro:property name="q_thigh" value="0.67"/>
  <xacro:property name="q_calf" value="-1.30"/>

  <!-- Lidar mount point (from khaledgabr77/unitree_go2_ros2 reference).
       The joint uses ${lidar_z + visual_z_offset}, so lidar_z = -0.03 - 0.045 = -0.075
       to place the sensor at z=-0.03 relative to base_link (same as reference). -->
  <xacro:property name="lidar_x" value="0.25"/>
  <xacro:property name="lidar_y" value="-0.038"/>
  <xacro:property name="lidar_z" value="-0.075"/>
  <xacro:property name="lidar_r" value="0.0"/>
  <xacro:property name="lidar_p" value="0.0"/>
  <xacro:property name="lidar_yaw" value="0.0"/>

  <xacro:macro name="go2_leg_visual" params="
      prefix
      hip_x
      hip_y
      thigh_y
      hip_visual_rpy
      thigh_mesh
      calf_mesh">
    <link name="${prefix}_hip">
      <visual>
        <origin xyz="0 0 0" rpy="${hip_visual_rpy}"/>
        <geometry>
          <mesh filename="package://${mesh_pkg}/meshes/dae/hip.dae"/>
        </geometry>
      </visual>
    </link>

    <joint name="${prefix}_hip_joint" type="fixed">
      <origin xyz="${hip_x} ${hip_y} ${visual_z_offset}" rpy="${q_hip} 0 0"/>
      <parent link="base_link"/>
      <child link="${prefix}_hip"/>
    </joint>

    <link name="${prefix}_thigh">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://${mesh_pkg}/meshes/dae/${thigh_mesh}"/>
        </geometry>
      </visual>
    </link>

    <joint name="${prefix}_thigh_joint" type="fixed">
      <origin xyz="0 ${thigh_y} 0" rpy="0 ${q_thigh} 0"/>
      <parent link="${prefix}_hip"/>
      <child link="${prefix}_thigh"/>
    </joint>

    <link name="${prefix}_calf">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://${mesh_pkg}/meshes/dae/${calf_mesh}"/>
        </geometry>
      </visual>
    </link>

    <joint name="${prefix}_calf_joint" type="fixed">
      <origin xyz="0 0 -0.213" rpy="0 ${q_calf} 0"/>
      <parent link="${prefix}_thigh"/>
      <child link="${prefix}_calf"/>
    </joint>

    <link name="${prefix}_foot">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://${mesh_pkg}/meshes/dae/foot.dae"/>
        </geometry>
      </visual>
    </link>

    <joint name="${prefix}_foot_joint" type="fixed">
      <origin xyz="0 0 -0.213" rpy="0 0 0"/>
      <parent link="${prefix}_calf"/>
      <child link="${prefix}_foot"/>
    </joint>
  </xacro:macro>

  <link name="base_footprint">
    <visual>
      <geometry><box size="0.001 0.001 0.001"/></geometry>
    </visual>
  </link>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0.021112 0 -0.005366" rpy="0 0 0"/>
      <mass value="${trunk_mass}"/>
      <inertia ixx="0.02448" ixy="0.00012166" ixz="0.0014849" iyy="0.098077" iyz="-3.12E-05" izz="0.107"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${visual_z_offset}" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://${mesh_pkg}/meshes/dae/base.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${trunk_length} ${trunk_width} ${trunk_height}"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 ${contact_proxy_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${contact_proxy_length} ${contact_proxy_width} ${contact_proxy_height}"/>
      </geometry>
    </collision>
  </link>

  <xacro:go2_leg_visual
      prefix="FL"
      hip_x="0.1934"
      hip_y="0.0465"
      thigh_y="0.0955"
      hip_visual_rpy="0 0 0"
      thigh_mesh="thigh.dae"
      calf_mesh="calf.dae"/>

  <xacro:go2_leg_visual
      prefix="FR"
      hip_x="0.1934"
      hip_y="-0.0465"
      thigh_y="-0.0955"
      hip_visual_rpy="3.141592653589793 0 0"
      thigh_mesh="thigh_mirror.dae"
      calf_mesh="calf_mirror.dae"/>

  <xacro:go2_leg_visual
      prefix="RL"
      hip_x="-0.1934"
      hip_y="0.0465"
      thigh_y="0.0955"
      hip_visual_rpy="0 3.141592653589793 0"
      thigh_mesh="thigh.dae"
      calf_mesh="calf.dae"/>

  <xacro:go2_leg_visual
      prefix="RR"
      hip_x="-0.1934"
      hip_y="-0.0465"
      thigh_y="-0.0955"
      hip_visual_rpy="3.141592653589793 3.141592653589793 0"
      thigh_mesh="thigh_mirror.dae"
      calf_mesh="calf_mirror.dae"/>

  <joint name="imu_joint" type="fixed">
    <origin xyz="-0.02557 0 ${0.04232 + visual_z_offset}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>

  <joint name="radar_joint" type="fixed">
    <origin xyz="0.28945 0 ${-0.046825 + visual_z_offset}" rpy="0 2.8782 0"/>
    <parent link="base_link"/>
    <child link="radar"/>
  </joint>

  <link name="radar"/>

  <joint name="front_camera_joint" type="fixed">
    <origin xyz="0.32715 -0.00003 ${0.04297 + visual_z_offset}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_camera_link"/>
  </joint>

  <link name="front_camera_link"/>

  <joint name="base_link_to_lidar" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z + visual_z_offset}" rpy="${lidar_r} ${lidar_p} ${lidar_yaw}"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.06"/>
      </geometry>
      <material name="lidar_black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
    <self_collide>false</self_collide>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>

  <gazebo reference="lidar_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo>
    <plugin name="gazebo_ros_planar_move" filename="libgazebo_ros_planar_move.so">
      <ros>
        <remapping>cmd_vel:=/cmd_vel</remapping>
        <remapping>odom:=/odom</remapping>
      </ros>
      <update_rate>50</update_rate>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <covariance_x>0.0001</covariance_x>
      <covariance_y>0.0001</covariance_y>
      <covariance_yaw>0.01</covariance_yaw>
    </plugin>
  </gazebo>

  <!-- L1 sensor parameters from khaledgabr77/unitree_go2_ros2 reference:
       600 h-samples, 30 v-channels, range 0.8–30 m, noise σ=0.008 m. -->
  <xacro:l1_lidar_gazebo
      parent_link="lidar_link"
      topic="/unilidar/cloud"
      update_rate="10"
      h_samples="600"
      v_samples="30"
      v_min_angle_deg="-45.0"
      v_max_angle_deg="45.0"
      range_min="0.8"
      range_max="30.0"
      noise_stddev="0.008"
      visualize="false"
  />

  <gazebo reference="imu_link">
    <sensor type="imu" name="go2_imu">
      <always_on>true</always_on>
      <update_rate>250</update_rate>
      <plugin name="gazebo_ros_imu" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=/unilidar/imu</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

</robot>
