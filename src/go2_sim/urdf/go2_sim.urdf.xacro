<?xml version="1.0"?>
<!--
  go2_sim.urdf.xacro
  Unitree Go2 - Gazebo Classic (Gazebo 11) simulation model.

  Visual model: official Unitree meshes from
    https://github.com/unitreerobotics/unitree_ros/tree/master/robots/go2_description

  Leg joints are fixed at the nominal standing pose:
    hip=0.0 rad, thigh=0.67 rad, calf=-1.30 rad.

  This keeps the robot visually correct while avoiding joint-control instability.
  The planar_move plugin still drives locomotion via /cmd_vel as before.

  Frame tree:
    base_footprint (ground reference, Nav2 root)
      -> base_link (maps to upstream link "base")
         -> FL_hip -> FL_thigh -> FL_calf -> FL_foot
         -> FR_hip -> FR_thigh -> FR_calf -> FR_foot
         -> RL_hip -> RL_thigh -> RL_calf -> RL_foot
         -> RR_hip -> RR_thigh -> RR_calf -> RR_foot
         -> imu_link
         -> lidar_link
         -> radar
         -> front_camera_link

  Topics/TF interface (unchanged):
    /cmd_vel, /odom, /unilidar/cloud, /unilidar/imu
    TF: odom -> base_footprint -> base_link
-->
<robot name="go2_sim" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- L1 LiDAR macro (unchanged) -->
  <xacro:include filename="$(find sensor_models)/urdf/l1_lidar.urdf.xacro"/>

  <!-- Physical constants (upstream go2_description const/urdf values) -->
  <xacro:property name="trunk_length" value="0.3762"/>
  <xacro:property name="trunk_width" value="0.0935"/>
  <xacro:property name="trunk_height" value="0.114"/>
  <xacro:property name="trunk_mass" value="6.921"/>

  <!-- Standing pose -->
  <xacro:property name="q_hip" value="0.0"/>
  <xacro:property name="q_thigh" value="0.67"/>
  <xacro:property name="q_calf" value="-1.30"/>

  <!-- Base height in world when feet are on ground -->
  <xacro:property name="base_z" value="0.380"/>

  <!-- LiDAR mount from official Unitree Go2 specifications (radar_joint) -->
  <xacro:property name="lidar_x" value="0.28945"/>
  <xacro:property name="lidar_y" value="0.0"/>
  <xacro:property name="lidar_z" value="-0.046825"/>
  <xacro:property name="lidar_r" value="0.0"/>
  <!-- <xacro:property name="lidar_p" value="2.8782"/> -->
  <xacro:property name="lidar_p" value="0.0"/>
  <xacro:property name="lidar_yaw" value="0.0"/>

  <!-- Mesh package (Option A: vendored meshes in go2_sim) -->
  <xacro:property name="mesh_pkg" value="go2_sim"/>

  <link name="base_footprint">
    <visual>
      <geometry><box size="0.001 0.001 0.001"/></geometry>
    </visual>
  </link>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0.021112 0 -0.005366" rpy="0 0 0"/>
      <mass value="${trunk_mass}"/>
      <inertia ixx="0.02448" ixy="0.00012166" ixz="0.0014849" iyy="0.098077" iyz="-3.12E-05" izz="0.107"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://${mesh_pkg}/meshes/dae/base.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="${trunk_length} ${trunk_width} ${trunk_height}"/>
      </geometry>
    </collision>
  </link>

  <link name="FL_hip">
    <inertial>
      <origin xyz="-0.0054 0.00194 -0.000105" rpy="0 0 0"/>
      <mass value="0.678"/>
      <inertia ixx="0.00048" ixy="-3.01E-06" ixz="1.11E-06" iyy="0.000884" iyz="-1.42E-06" izz="0.000596"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://${mesh_pkg}/meshes/dae/hip.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0.08 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.046"/>
      </geometry>
    </collision>
  </link>

  <joint name="FL_hip_joint" type="fixed">
    <origin xyz="0.1934 0.0465 0" rpy="${q_hip} 0 0"/>
    <parent link="base_link"/>
    <child link="FL_hip"/>
  </joint>

  <link name="FL_hip_rotor">
    <inertial>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
      <mass value="0.089"/>
      <inertia ixx="0.000111842" ixy="0.0" ixz="0.0" iyy="0.000059647" iyz="0.0" izz="0.000059647"/>
    </inertial>
  </link>

  <joint name="FL_hip_rotor_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.11215 0.04675 0"/>
    <parent link="base_link"/>
    <child link="FL_hip_rotor"/>
  </joint>

  <link name="FL_thigh">
    <inertial>
      <origin xyz="-0.00374 -0.0223 -0.0327" rpy="0 0 0"/>
      <mass value="1.152"/>
      <inertia ixx="0.00584" ixy="8.72E-05" ixz="-0.000289" iyy="0.0058" iyz="0.000808" izz="0.00103"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://${mesh_pkg}/meshes/dae/thigh.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 1.5707963267948966 0" xyz="0 0 -0.1065"/>
      <geometry>
        <box size="0.213 0.0245 0.034"/>
      </geometry>
    </collision>
  </link>

  <joint name="FL_thigh_joint" type="fixed">
    <origin xyz="0 0.0955 0" rpy="0 ${q_thigh} 0"/>
    <parent link="FL_hip"/>
    <child link="FL_thigh"/>
  </joint>

  <link name="FL_thigh_rotor">
    <inertial>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
      <mass value="0.089"/>
      <inertia ixx="0.000059647" ixy="0.0" ixz="0.0" iyy="0.000111842" iyz="0.0" izz="0.000059647"/>
    </inertial>
  </link>

  <joint name="FL_thigh_rotor_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 -0.00015 0"/>
    <parent link="FL_hip"/>
    <child link="FL_thigh_rotor"/>
  </joint>

  <link name="FL_calf">
    <inertial>
      <origin xyz="0.00548 -0.000975 -0.115" rpy="0 0 0"/>
      <mass value="0.154"/>
      <inertia ixx="0.00108" ixy="3.4E-07" ixz="1.72E-05" iyy="0.0011" iyz="8.28E-06" izz="3.29E-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://${mesh_pkg}/meshes/dae/calf.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 -0.21 0" xyz="0.008 0 -0.06"/>
      <geometry>
        <cylinder length="0.12" radius="0.012"/>
      </geometry>
    </collision>
  </link>

  <joint name="FL_calf_joint" type="fixed">
    <origin xyz="0 0 -0.213" rpy="0 ${q_calf} 0"/>
    <parent link="FL_thigh"/>
    <child link="FL_calf"/>
  </joint>

  <link name="FL_calflower">
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.065" radius="0.011"/>
      </geometry>
    </collision>
  </link>

  <joint name="FL_calflower_joint" type="fixed">
    <origin xyz="0.020 0 -0.148" rpy="0 0.05 0"/>
    <parent link="FL_calf"/>
    <child link="FL_calflower"/>
  </joint>

  <link name="FL_calflower1">
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.0155"/>
      </geometry>
    </collision>
  </link>

  <joint name="FL_calflower1_joint" type="fixed">
    <origin xyz="-0.01 0 -0.04" rpy="0 0.48 0"/>
    <parent link="FL_calflower"/>
    <child link="FL_calflower1"/>
  </joint>

  <link name="FL_calf_rotor">
    <inertial>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
      <mass value="0.089"/>
      <inertia ixx="0.000059647" ixy="0.0" ixz="0.0" iyy="0.000111842" iyz="0.0" izz="0.000059647"/>
    </inertial>
  </link>

  <joint name="FL_calf_rotor_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 -0.03235 0"/>
    <parent link="FL_thigh"/>
    <child link="FL_calf_rotor"/>
  </joint>

  <link name="FL_foot">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.04"/>
      <inertia ixx="9.6e-06" ixy="0" ixz="0" iyy="9.6e-06" iyz="0" izz="9.6e-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://${mesh_pkg}/meshes/dae/foot.dae"/>
