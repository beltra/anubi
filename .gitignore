# ROS 2 Colcon workspace directories
build/
install/
log/


# Python generated files
__pycache__/
*.py[cod]
*$py.class

# Python virtual environments
venv/
.venv/
env/

# C++ build artifacts
*.o
*.so
*.a
*.dylib
*.dll

# OS generated files
.DS_Store
Thumbs.db

# Text editor / IDE configurations / AI generated files
.vscode/
.idea/
*.swp
*.codex
*.claude
*.agents
*.pytest_cache
*.cache

# Local git worktrees
.worktrees/

# Rosbag recordings (large, machine-local). Keep the directory and any
# checked-in README, but not the recordings themselves.
bags/*
!bags/.gitkeep
!bags/README.md

# Generated map artifacts (PGM/PCD/YAML from slam_toolbox / DLIO). Local
# outputs of scripts/save_current_maps.sh; not part of the source tree.
maps/
